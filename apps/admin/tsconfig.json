{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@alaya/ui": [
        "../../packages/ui/src"
      ],
      "@alaya/config": [
        "../../packages/config/src"
      ],
      "@alaya/utils": [
        "../../packages/utils/src"
      ],
      "@alaya/db": [
        "../../packages/db/src"
      ]
    },
    "allowJs": true,
    "noEmit": true
  },
  "include": [
    ".next/types/**/*.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules"
  ]
}
