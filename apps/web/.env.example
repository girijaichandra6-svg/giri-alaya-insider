# Database
DATABASE_URL="postgresql://user:password@host:5432/alayainsider"

# Redis
REDIS_URL="redis://localhost:6379"

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=...
SANITY_API_TOKEN=...

# Cloudflare R2
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=...

# Typesense
TYPESENSE_API_KEY=...
TYPESENSE_HOST=...
TYPESENSE_PORT=443

# OpenAI
OPENAI_API_KEY=...

# Resend
RESEND_API_KEY=...

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
POSTHOG_API_KEY=...
POSTHOG_HOST=...

# Sentry
SENTRY_DSN=...

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Typesense Search
TYPESENSE_API_KEY="your-typesense-api-key"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT=443
TYPESENSE_PROTOCOL="https"

# Typesense Sync (protection for sync/webhook endpoints)
TYPESENSE_SYNC_SECRET="generate-a-random-secret"

# Typesense Sync Batching (optional, defaults to 50)
TYPESENSE_BATCH_SIZE=50
