generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ---- AUTH & USER MANAGEMENT ----
model User {
  id            String    @id @default(cuid())
  clerkId       String    @unique
  email         String    @unique
  name          String?
  avatarUrl     String?
  role          UserRole  @default(USER)
  language      String    @default("en")
  country       String?
  currency      String?
  theme         String?   @default("dark")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  posts         Post[]
  reviews       Review[]
  comments      Comment[]
  wishlists     Wishlist[]
  priceAlerts   PriceAlert[]
  notifications Notification[]
  referrals     Referral[]        @relation("ReferringUser")
  referredBy    Referral[]        @relation("ReferredUser")
  achievements  UserAchievement[]
  points        LoyaltyPoint[]
  collections   Collection[]
  followerRelations  Follow[]     @relation("Following")
  followingRelations Follow[]    @relation("Follower")
  searchHistory SearchHistory[]
  recentlyViewed RecentlyViewed[]
  auditLogs     AuditLog[]
  pushTokens    PushToken[]
  emailSubscriptions EmailSubscription[]
  abTests       ABTestUser[]
  savedProducts SavedProduct[]
  qa                QA[]
  deletedAt     DateTime?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

enum UserRole {
  USER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

model PushToken {
  id      String @id @default(cuid())
  userId  String
  token   String
  device  String?
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model EmailSubscription {
  id        String   @id @default(cuid())
  userId    String?
  email     String   @unique
  status    SubscriptionStatus @default(ACTIVE)
  segments  String[]
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([status])
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
}

// ---- CONTENT STRUCTURE ----
model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  accentColor String  @default("#D4FF00")
  imageUrl    String?
  parentId    String?
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  posts       Post[]
  subcategories Subcategory[]
  metadata    Json?
  @@index([slug])
  @@index([parentId])
}

model Subcategory {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  products    Product[]
  @@index([categoryId])
  @@index([slug])
}

model Product {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  brand           String?
  description     String
  specs           Json?
  categoryId      String
  subcategoryId   String?
  imageUrls       String[]
  videoUrls       String[]
  basePrice       Decimal?
  currency        String    @default("USD")
  isActive        Boolean   @default(true)
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  category        Category  @relation(fields: [categoryId], references: [id])
  subcategory     Subcategory? @relation(fields: [subcategoryId], references: [id])
  affiliateLinks  AffiliateLink[]
  priceSnapshots  PriceSnapshot[]
  reviews         Review[]
  productScores   ProductScore[]
  deals           Deal[]
  coupons         Coupon[]
  collectionItems CollectionProduct[]
  savedBy         SavedProduct[]
  trending        TrendingProduct[]
  tags            ProductTag[]
  qa              QA[]
  relatedProducts ProductRelation[] @relation("ProductFrom")
  relatedTo       ProductRelation[] @relation("ProductTo")
  embeddings      Embedding?
  wishlistItems     WishlistItem[]
  priceAlerts       PriceAlert[]
  recentlyViewedBy  RecentlyViewed[]
  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isActive])
  @@index([createdAt])
}

model ProductTag {
  id        String  @id @default(cuid())
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([productId, tagId])
  @@index([tagId])
}

model Tag {
  id       String       @id @default(cuid())
  name     String       @unique
  products ProductTag[]
  posts    PostTag[]
}

model Brand {
  id       String    @id @default(cuid())
  name     String    @unique
  logoUrl  String?
}

model Retailer {
  id              String         @id @default(cuid())
  name            String         @unique
  website         String
  trustScore      Float          @default(0)
  logoUrl         String?
  affiliateLinks  AffiliateLink[]
  deals           Deal[]
  @@index([trustScore])
  coupons           Coupon[]
}

model AffiliateNetwork {
  id          String         @id @default(cuid())
  name        String
  identifier  String         @unique
  config      Json?
  links       AffiliateLink[]
}

model AffiliateLink {
  id              String   @id @default(cuid())
  productId       String
  retailerId      String
  networkId       String
  url             String
  cloakedUrl      String?
  localizedLinks  Json?
  isActive        Boolean  @default(true)
  splitTestGroup  String?
  priority        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  product         Product          @relation(fields: [productId], references: [id])
  retailer        Retailer         @relation(fields: [retailerId], references: [id])
  network         AffiliateNetwork @relation(fields: [networkId], references: [id])
  clicks          Click[]
  conversions     Conversion[]
  @@index([productId])
  @@index([retailerId])
  @@index([networkId])
  @@index([isActive])
  @@index([priority])
  localizedLinkEntries LocalizedLink[]
}

model LocalizedLink {
  id          String   @id @default(cuid())
  linkId      String
  country     String
  url         String
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  @@index([linkId])
  @@index([country])
}

model Click {
  id          String   @id @default(cuid())
  linkId      String
  userId      String?
  ip          String?
  userAgent   String?
  country     String?
  timestamp   DateTime @default(now())
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id])
  @@index([linkId])
  @@index([timestamp])
  @@index([country])
  conversions      Conversion[]
}

model Conversion {
  id          String   @id @default(cuid())
  clickId     String?
  linkId      String
  orderId     String?
  amount      Decimal
  commission  Decimal?
  currency    String
  status      String   @default("pending")
  timestamp   DateTime @default(now())
  affiliateLink AffiliateLink @relation(fields: [linkId], references: [id])
  click       Click?          @relation(fields: [clickId], references: [id])
  @@index([linkId])
  @@index([clickId])
  @@index([timestamp])
  @@index([status])
}

model PriceSnapshot {
  id        String   @id @default(cuid())
  productId String
  retailerId String?
  price     Decimal
  currency  String
  timestamp DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  @@index([productId])
  @@index([timestamp])
}

model Deal {
  id          String   @id @default(cuid())
  productId   String
  retailerId  String?
  title       String
  description String?
  code        String?
  discount    Float?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  product     Product  @relation(fields: [productId], references: [id])
  retailer    Retailer? @relation(fields: [retailerId], references: [id])
  @@index([productId])
  @@index([isActive])
  @@index([endDate])
}

model Coupon {
  id         String   @id @default(cuid())
  code       String
  description String
  productId  String?
  retailerId String?
  discount   String?
  expiresAt  DateTime?
  product    Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  retailer   Retailer? @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  @@index([code])
  @@index([productId])
}

// ---- SOCIAL & COMMUNITY ----
model Review {
  id        String   @id @default(cuid())
  userId    String
  productId String
  rating    Int
  title     String?
  body      String
  pros      String?
  cons      String?
  isVerifiedPurchase Boolean @default(false)
  helpfulCount Int   @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  comments  Comment[]
  @@index([productId])
  @@index([userId])
  @@index([rating])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  userId    String
  reviewId  String?
  postId    String?
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  review    Review?  @relation(fields: [reviewId], references: [id])
  post      Post?    @relation(fields: [postId], references: [id])
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id])
  replies   Comment[] @relation("CommentReplies")
  @@index([userId])
  @@index([reviewId])
  @@index([postId])
  @@index([parentId])
}

model QA {
  id        String   @id @default(cuid())
  productId String
  question  String
  answer    String?
  userId    String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@index([productId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  isPublic  Boolean  @default(false)
  products  WishlistItem[]
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
}

model WishlistItem {
  id         String   @id @default(cuid())
  wishlistId String
  productId  String
  addedAt    DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([wishlistId, productId])
  @@index([productId])
}

model SavedProduct {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([productId])
}

model Collection {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  imageUrl    String?
  isPublic    Boolean  @default(true)
  userId      String?
  type        CollectionType @default(EDITORIAL)
  products    CollectionProduct[]
  user        User?    @relation(fields: [userId], references: [id])
  @@index([slug])
  @@index([userId])
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  order        Int      @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([collectionId, productId])
  @@index([productId])
}

enum CollectionType {
  EDITORIAL
  USER
  SEASONAL
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Follower", fields: [followerId], references: [id])
  following   User     @relation("Following", fields: [followingId], references: [id])
  @@unique([followerId, followingId])
  @@index([followingId])
}

// ---- CONTENT MANAGEMENT ----
model Post {
  id            String    @id @default(cuid())
  slug          String    @unique
  title         String
  excerpt       String?
  content       String?
  coverImageUrl String?
  type          PostType
  categoryId    String?
  authorId      String?
  status        PostStatus @default(DRAFT)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  metadata      Json?
  tags          PostTag[]
  comments      Comment[]
  author        User?     @relation(fields: [authorId], references: [id])
  category      Category? @relation(fields: [categoryId], references: [id])
  @@index([slug])
  @@index([status])
  @@index([publishedAt])
  @@index([categoryId])
  @@index([authorId])
}

model PostTag {
  id     String @id @default(cuid())
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  @@unique([postId, tagId])
  @@index([tagId])
}

enum PostType {
  ARTICLE
  GUIDE
  REVIEW
  COMPARISON
  DEAL
  NEWS
  GLOSSARY
  WEB_STORY
  VIDEO
}

enum PostStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

// ---- PRODUCT INTELLIGENCE ----
model ProductScore {
  id        String   @id @default(cuid())
  productId String
  type      ScoreType
  score     Float
  updatedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  @@unique([productId, type])
  @@index([type])
}

enum ScoreType {
  EDITORIAL
  AI
  COMMUNITY
}

model Embedding {
  id        String   @id @default(cuid())
  productId String   @unique
  vector    Unsupported("vector(1536)")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductRelation {
  id           String       @id @default(cuid())
  fromId       String
  toId         String
  relationType RelationType
  productFrom  Product      @relation("ProductFrom", fields: [fromId], references: [id])
  productTo    Product      @relation("ProductTo", fields: [toId], references: [id])
  @@unique([fromId, toId, relationType])
  @@index([toId])
}

enum RelationType {
  ALSO_BOUGHT
  RELATED
  ALTERNATIVE
}

model TrendingProduct {
  id        String   @id @default(cuid())
  productId String
  score     Float
  window    String
  updatedAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, window])
  @@index([window])
  @@index([score])
}

// ---- USER ENGAGEMENT & LOYALTY ----
model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  imageUrl    String
  criteria    Json?
  achievements      UserAchievement[]
}

model UserAchievement {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  earnedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  badge     Badge    @relation(fields: [badgeId], references: [id])
  @@unique([userId, badgeId])
  @@index([badgeId])
}

model LoyaltyPoint {
  id        String   @id @default(cuid())
  userId    String
  points    Int
  source    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([source])
}

model Referral {
  id           String         @id @default(cuid())
  referrerId   String
  referredId   String
  code         String         @unique
  status       ReferralStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  referrer     User           @relation("ReferringUser", fields: [referrerId], references: [id])
  referred     User           @relation("ReferredUser", fields: [referredId], references: [id])
  @@unique([referrerId, referredId])
}

enum ReferralStatus {
  PENDING
  COMPLETED
}

model PriceAlert {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  targetPrice Decimal
  currency    String
  isActive    Boolean  @default(true)
  triggeredAt DateTime?
  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
  @@index([userId])
  @@index([productId])
  @@index([isActive])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  message   String
  data      Json?
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([readAt])
}

// ---- SEARCH & ANALYTICS ----
model SearchHistory {
  id        String   @id @default(cuid())
  userId    String?
  query     String
  filters   Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([createdAt])
  @@index([query])
}

model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String
  productId String
  viewedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([userId, productId])
  @@index([productId])
}

// ---- OPERATIONAL & AUDIT ----
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entity     String
  entityId   String?
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  @@index([userId])
  @@index([entity])
  @@index([entityId])
  @@index([createdAt])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  enabled     Boolean  @default(false)
  rules       Json?
}

model ABTest {
  id          String           @id @default(cuid())
  name        String
  description String?
  status      ExperimentStatus @default(DRAFT)
  variants    Json
  startDate   DateTime?
  endDate     DateTime?
  users       ABTestUser[]
}

model ABTestUser {
  id        String   @id @default(cuid())
  testId    String
  userId    String
  variant   String
  assignedAt DateTime @default(now())
  test      ABTest   @relation(fields: [testId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  @@unique([testId, userId])
  @@index([userId])
}

enum ExperimentStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
}

// ---- INTERNATIONALIZATION ----
model Translation {
  id        String @id @default(cuid())
  tableName String
  rowId     String
  field     String
  language  String
  value     String
  @@unique([tableName, rowId, field, language])
  @@index([language])
  @@index([rowId])
}

model CountrySetting {
  id       String @id @default(cuid())
  country  String @unique
  currency String
  language String
  defaultRetailers Json?
}

model CurrencyRate {
  id        String   @id @default(cuid())
  base      String
  target    String
  rate      Float
  updatedAt DateTime @default(now())
  @@unique([base, target])
}
